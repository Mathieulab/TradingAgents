# Copy this file to finance_lab.local.yaml for private machine-specific settings.
# Do not commit real API keys, broker credentials, or account identifiers.

llm:
  provider: ollama
  base_url: http://localhost:11434/v1
  deep_think_model: qwen3-coder:30b-a3b-q4_K_M
  quick_think_model: qwen3:8b
  temperature: 0.0

mode:
  real_trading_enabled: false
  paper_trading_enabled: true
  backtesting_enabled: true

paths:
  reports_dir: ./finance_lab/reports
  notebooks_dir: ./finance_lab/notebooks
  fake_trades_db: ./finance_lab/fake_trading/fake_trades.db

risk:
  max_position_size_percent: 5
  max_daily_loss_percent: 2
  require_human_approval: true
